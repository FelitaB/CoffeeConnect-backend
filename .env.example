# Passwordless local MySQL (for example, a default Homebrew installation):
# DATABASE_URL="mysql://root:@localhost:3306/CoffeeConnect"
# Password-protected local MySQL (replace YOUR_PASSWORD):
# DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/CoffeeConnect"
# URL-encode special characters in the password.

DATABASE_URL="mysql://root:@localhost:3306/CoffeeConnect"



# Comma-separated list of frontend origins allowed to call the API

CORS_ORIGIN="http://localhost:3000"