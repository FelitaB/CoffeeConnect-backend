# The syntax of the database url is as follows: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# An example of a database connection with username root and an empty password at port 3306: mysql://root:@localhost:3306/CoffeeConnect

DATABASE_URL="ENTER_DATABASE_URL_HERE"



