// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Person {
  id               Int      @id @default(autoincrement())
  first_name       String
  last_name        String
  email            String   @unique
  location         Location
  job_role         JobRole
  job_capability   String
  job_go_to_market String
  hashedPassword   String?
  registered       Boolean  @default(false)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  interests      Interest[]
  sent_chats     Chat[]     @relation("ChatSender")
  received_chats Chat[]     @relation("ChatReceiver")
  initiated_matches Match[]  @relation("MatchPerson")
  received_matches  Match[]  @relation("MatchCandidate")
  booking_proposals BookingProposal[] @relation("BookingProposalProposer")
}

model Interest {
  id      Int      @id @default(autoincrement())
  name    String   @unique
  created DateTime @default(now())
  people  Person[]
}

model Chat {
  id          String     @id @default(uuid())
  sender_id   Int
  receiver_id Int
  location_id String
  datetime    DateTime
  status      ChatStatus @default(PENDING)
  created_at  DateTime   @default(now())

  sender   Person @relation("ChatSender", fields: [sender_id], references: [id])
  receiver Person @relation("ChatReceiver", fields: [receiver_id], references: [id])

  @@index([sender_id])
  @@index([receiver_id])
}

model Match {
  id         Int         @id @default(autoincrement())
  person_id  Int
  match_id   Int
  status     MatchStatus @default(OFFERED)
  created_at DateTime    @default(now())
  matched_at DateTime?
  completed_at DateTime?

  person Person @relation("MatchPerson", fields: [person_id], references: [id], onDelete: Cascade)
  match  Person @relation("MatchCandidate", fields: [match_id], references: [id], onDelete: Cascade)
  booking Booking?

  @@unique([person_id, match_id])
  @@index([person_id, status])
  @@index([match_id, status])
  @@index([status, matched_at])
}

model Booking {
  id           Int           @id @default(autoincrement())
  match_id     Int           @unique
  status       BookingStatus @default(PROPOSED)
  scheduled_at DateTime?
  confirmed_at DateTime?
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  match     Match             @relation(fields: [match_id], references: [id], onDelete: Cascade)
  proposals BookingProposal[]
}

model BookingProposal {
  id          Int                  @id @default(autoincrement())
  booking_id  Int
  proposed_by Int
  status      BookingProposalStatus @default(OPEN)
  created_at  DateTime             @default(now())

  booking  Booking       @relation(fields: [booking_id], references: [id], onDelete: Cascade)
  proposer Person        @relation("BookingProposalProposer", fields: [proposed_by], references: [id], onDelete: Cascade)
  slots    BookingSlot[]

  @@index([booking_id, status])
}

model BookingSlot {
  id          Int      @id @default(autoincrement())
  proposal_id Int
  starts_at   DateTime

  proposal BookingProposal @relation(fields: [proposal_id], references: [id], onDelete: Cascade)

  @@unique([proposal_id, starts_at])
  @@index([starts_at])
}

enum ChatStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  OFFERED
  PENDING
  ACCEPTED
  DECLINED
}

enum BookingStatus {
  PROPOSED
  CONFIRMED
}

enum BookingProposalStatus {
  OPEN
  ACCEPTED
  SUPERSEDED
}

enum JobRole {
  ANA
  CON
  CAN
  SNC
  PCN
  MCN
  DIR
  IDP
  APP
  APA
  CDR
  PAR
  SPR
}

enum Location {
  LONDON
  BELFAST
  MANCHESTER
}
